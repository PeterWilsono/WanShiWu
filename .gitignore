# ---- 万事屋 .gitignore（依据 PROJECT_SPEC.md 13.1）----

# 环境变量与密钥（绝不提交）
.env
.env.*
!.env.example

# 数据库文件与备份
*.db
*.db-wal
*.db-shm
backend/data/
*.sqlite
*.sqlite3
backups/
*.bak

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
backend/evals/*-report.json
dist/

# Node / 前端
node_modules/
frontend/dist/
*.local

# IDE / 编辑器
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# WorkBuddy 助手工作记忆、应用预览卡与本地浏览器验收产物（不入库）
.workbuddy/
.wbapp_*.genie
.playwright-cli/
.cache/
.npm-cache/
.gradle/
.tools/
release/
desktop/.smoke-data/
desktop/data/
desktop/.ui-data*/
desktop/.ui-userdata*/
desktop/artifacts/
desktop/release-build/
desktop/tests/.tmp-data-location/
desktop/test-install/

# 本地文档生成流水线与日志（成品通过预览或单独分发）
output/
logs/
